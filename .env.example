# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for interactive technician tracking.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# Phone OTP is managed by Supabase Auth. Enable Phone authentication,
# configure the SMS provider and rate limits in the Supabase dashboard,
# and set the SMS OTP length to 6. No local OTP fallback is supported.
# Never put SMS-provider credentials in VITE_* variables.

# Supabase Configuration
# SUPABASE_URL: Your Supabase project URL
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# Public project key used by server-side JWT verification (not an admin key).
SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_PUBLIC_KEY"
# Legacy full-array WebSocket sync is disabled. Local synthetic-data demos only:
# requires NODE_ENV=development, loopback origin/address, and NO SUPABASE_SECRET_KEY.
ENABLE_LOCAL_DEMO_SYNC="false"
VITE_ENABLE_LOCAL_DEMO_SYNC="false"
# SUPABASE_SECRET_KEY: Your Supabase secret key (server only, never expose)
SUPABASE_SECRET_KEY="sb_secret_YOUR_SECRET_KEY"
# VITE_SUPABASE_URL: Same as SUPABASE_URL (for client)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# VITE_SUPABASE_ANON_KEY: Your Supabase anon public key (safe for client)
VITE_SUPABASE_ANON_KEY="sb_publishable_YOUR_ANON_KEY"
